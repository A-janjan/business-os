# ---- Core ----
ENV=development
LOG_LEVEL=INFO

# ---- Database ----
# Default: SQLite at data/business_os.db (zero setup). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/business_os

# ---- Knowledge vault ----
# KNOWLEDGE_DIR=knowledge

# ---- Security ----
# Generate a strong secret, e.g.: openssl rand -hex 32
AUTH_SECRET=change-me-in-production
# Minutes until an access token expires (default 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Registration after the first admin: only when you know what you are doing.
ADMIN_BOOTSTRAP=false

# ---- AI (OpenAI-compatible provider) ----
# Examples:
#   OpenAI:      AI_BASE_URL=https://api.openai.com/v1
#   Ollama:      AI_BASE_URL=http://localhost:11434/v1
#   Groq:        AI_BASE_URL=https://api.groq.com/openai/v1
#   vLLM/LM Studio/local endpoints: set their OpenAI-compatible /v1 base URL.
AI_ENABLED=true
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=120
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=4096
AI_MAX_RETRIES=2

# ---- n8n automation ----
N8N_ENABLED=false
N8N_WEBHOOK_BASE_URL=
N8N_API_KEY=

# ---- CORS (production: comma-separated explicit origins) ----
CORS_ORIGINS=*
